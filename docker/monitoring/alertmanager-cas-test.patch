+// maxpostyCASBarrierLimits holds contenders after the stale map Load and before
+// CompareAndSwap, preserving all upstream recovery and delivery assertions.
+type maxpostyCASBarrierLimits struct {
+	ready   sync.WaitGroup
+	release chan struct{}
+}
+
+func (l *maxpostyCASBarrierLimits) MaxNumberOfAggregationGroups() int {
+	l.ready.Done()
+	<-l.release
+	return 0
+}
